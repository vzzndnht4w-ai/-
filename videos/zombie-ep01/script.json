{
 "slug": "zombie-ep01",
 "title": "Серия 1. Первый этаж: окно",
 "scenes": [
  {
   "id": "01",
   "lead": 0.6,
   "minDur": 6.0,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Правила пишут не чернилами. Именами. Вода идёт редкими окнами. Набираем всё."
    }
   ]
  },
  {
   "id": "02",
   "lead": 0.3,
   "minDur": 7.5,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Тетрадь чужая. Бориса Пахомова. Он ушёл к мосту. Оставил записку: «Проверяй каждое»."
    }
   ]
  },
  {
   "id": "03",
   "lead": 0.3,
   "minDur": 8.5,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Моя смена. Одиннадцать человек. Правило «не включать сирену» я написал за час. Бригадир сказал: «Потом»."
    }
   ]
  },
  {
   "id": "04",
   "lead": 0.4,
   "minDur": 5.5,
   "lines": [
    {
     "spk": "lesha",
     "text": "В туалет.",
     "gap": 0.48
    },
    {
     "spk": "mark_v",
     "text": "Туалет — в другой стороне. Записал: проверить."
    }
   ]
  },
  {
   "id": "05",
   "lead": 0.8,
   "minDur": 4.5,
   "lines": [
    {
     "spk": "lesha",
     "text": "Дымок…"
    }
   ]
  },
  {
   "id": "06",
   "lead": 0.3,
   "minDur": 6.2,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Утром Тамара Петровна взяла чайник. Я проверял людей. Окно — нет."
    }
   ]
  },
  {
   "id": "07",
   "lead": 1.8,
   "minDur": 4.6,
   "lines": [
    {
     "spk": "lesha",
     "text": "Я не закрыл окно."
    }
   ]
  },
  {
   "id": "08",
   "lead": 0.3,
   "minDur": 8.0,
   "lines": [
    {
     "spk": "inna",
     "text": "Пустите. Я фельдшер.",
     "gap": 0.48
    },
    {
     "spk": "mark",
     "text": "Нет. Они услышат.",
     "gap": 0.6
    },
    {
     "spk": "mark_v",
     "text": "Я закрыл дверь. Не в первый раз."
    }
   ]
  },
  {
   "id": "09",
   "lead": 0,
   "minDur": 4.0,
   "lines": []
  },
  {
   "id": "10",
   "lead": 0.3,
   "minDur": 8.0,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Правило номер один. Окно — тоже дверь. Закрывать изнутри. Проверять каждое. Цена — Тамара Петровна."
    }
   ]
  },
  {
   "id": "11",
   "lead": 0.3,
   "minDur": 9.0,
   "lines": [
    {
     "spk": "mark",
     "text": "Окна — твои. Утром и вечером.",
     "gap": 0.48
    },
    {
     "spk": "mark_v",
     "text": "Свет — не напротив стекла. Мебель — к стене. Не из учебника. Из потерь."
    }
   ]
  },
  {
   "id": "12",
   "lead": 0.3,
   "minDur": 9.0,
   "lines": [
    {
     "spk": "inna",
     "text": "А если пожар?",
     "gap": 0.36
    },
    {
     "spk": "mark",
     "text": "Из каждой комнаты — два пути.",
     "gap": 0.48
    },
    {
     "spk": "mark_v",
     "text": "Выйти — меньше чем за две минуты. Так считают пожарные."
    }
   ]
  },
  {
   "id": "13",
   "lead": 0.3,
   "minDur": 9.0,
   "lines": [
    {
     "spk": "lesha",
     "text": "Холодно. Можно свечу?",
     "gap": 0.42
    },
    {
     "spk": "mark",
     "text": "Нет. Огонь в закрытой комнате — угарный газ. Его не видно.",
     "gap": 0.42
    },
    {
     "spk": "inna",
     "text": "Сначала голова. Потом сон."
    }
   ]
  },
  {
   "id": "14",
   "lead": 0.3,
   "minDur": 9.0,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Воды — на троих. Примерно четыре литра на человека в сутки. Запас — на трое суток.",
     "gap": 0.36
    },
    {
     "spk": "mark",
     "text": "Только пищевая посуда."
    }
   ]
  },
  {
   "id": "15",
   "lead": 0.4,
   "minDur": 6.5,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Инна прячет левую руку. Лёша ходит по ночам. Записал. Не спросил."
    }
   ]
  },
  {
   "id": "16",
   "lead": 0.3,
   "minDur": 8.5,
   "lines": [
    {
     "spk": "mark_v",
     "text": "Закрывай окна изнутри. Проверяй каждое."
    }
   ]
  }
 ]
}